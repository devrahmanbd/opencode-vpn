#!/bin/bash
# vpn-rotate - find a profile whose exit IP still has free-model quota.
#
# Free quota is per exit-IP and burns fast on popular exits, so rotation
# is the core loop of this project: connect each profile in turn and probe
# it with one cheap model call. First exit that answers wins and stays
# connected (saved as default via --daemon).
#
# Run AS ROOT on the server:  vpn-rotate [--model m] [--timeout s]
#   --model    probe model (default: opencode-zen/muse-spark-1.3-contributor-free)
#   --timeout  seconds per probe (default 90; burned exits fail fast anyway)
#
# Exit 0 with the working profile name; exit 1 if every profile is burned
# (then download fresh .ovpn files and install with vpn-add).
set -euo pipefail

MODEL="${MODEL:-opencode-zen/muse-spark-1.3-contributor-free}"
TIMEOUT=90

while [ $# -gt 0 ]; do
    case "$1" in
        --model) MODEL="${2:?--model needs a value}"; shift 2 ;;
        --timeout) TIMEOUT="${2:?--timeout needs seconds}"; shift 2 ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        *) echo "unknown flag: $1" >&2; exit 2 ;;
    esac
done

PROFILES="$(vpn-start --list 2>/dev/null | grep -E '^vpn[0-9]+$' || true)"
[ -n "$PROFILES" ] || { echo "no profiles found" >&2; exit 1; }

for p in $PROFILES; do
    echo "=== trying $p ==="
    vpn-start --"$p" --daemon >/dev/null 2>&1 || { echo "--$p daemon failed, next"; continue; }
    # wait for tunnel (state file matches + tun0 present), up to ~150s
    UP=0
    for _ in $(seq 1 75); do
        if grep -q "^$p " /etc/openvpn/client/current 2>/dev/null \
            && ip netns exec vpn ip -brief addr show tun0 2>/dev/null | grep -q '^tun0'; then
            UP=1; break
        fi
        sleep 2
    done
    if [ "$UP" != 1 ]; then echo "--$p tunnel never came up, next"; continue; fi
    EXIT_IP="$(ip netns exec vpn curl -s --max-time 10 https://ifconfig.me 2>/dev/null || true)"
    echo "--$p exit: ${EXIT_IP:-unreachable}"
    OUT="$(timeout "$TIMEOUT" opencode-vpn run -m "$MODEL" "reply with exactly this word: ok" 2>&1 || true)"
    if echo "$OUT" | grep -qx "ok"; then
        echo "WINNER: $p ($EXIT_IP) answers free model $MODEL"
        exit 0
    fi
    echo "--$p burned (no clean answer), next"
done

echo "ALL BURNED: every exit failed the probe."
echo "Download fresh NordVPN .ovpn configs and install with: vpn-add <name> <tcp.ovpn> <udp.ovpn>"
exit 1
