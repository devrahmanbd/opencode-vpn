#!/bin/bash
# Kill switch, runs INSIDE the vpn namespace (via --up, or manually with
# `ip netns exec vpn /usr/local/bin/vpn-killswitch`).
# Allows only: loopback, the VPN tunnel (tun0), the OpenVPN control channel
# to the NordVPN server, and the host side of the veth (10.200.1.1, harmless
# diagnostics). Everything else is dropped -> no fallback to host NAT if the
# tunnel dies.
#
# The control-channel destination is written by vpn-start to
# /etc/openvpn/client/killswitch.env (OpenVPN does not forward custom env
# vars to --up scripts). Defaults below keep standalone use working (vpn1).
set -e

KILLSWITCH_ENV=/etc/openvpn/client/killswitch.env
[ -f "$KILLSWITCH_ENV" ] && . "$KILLSWITCH_ENV" || true
VPN_SERVERS="${VPN_SERVERS:-94.156.149.196}"
VPN_PORTS="${VPN_PORTS:-1231,1232,1233,1234}"
VPN_PROTO="${VPN_PROTO:-tcp}"
IPT=/usr/sbin/iptables

$IPT -F INPUT
$IPT -F OUTPUT
$IPT -P INPUT DROP
$IPT -A INPUT -i lo -j ACCEPT
$IPT -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
# OpenHands controller (docker host, 10.200.1.1) -> edge OpenResty (10.200.1.2:443)
$IPT -A INPUT -s 10.200.1.0/24 -p tcp --dport 443 -j ACCEPT

$IPT -P OUTPUT DROP
$IPT -A OUTPUT -o lo -j ACCEPT
$IPT -A OUTPUT -o tun0 -j ACCEPT
for srv in $VPN_SERVERS; do
    $IPT -A OUTPUT -d "$srv" -p "$VPN_PROTO" -m multiport --dports "$VPN_PORTS" -j ACCEPT
done
$IPT -A OUTPUT -d 10.200.1.1 -j ACCEPT
