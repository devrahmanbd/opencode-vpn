#!/bin/bash
# Launch local OpenCode with its traffic egressing via the Mac's OWN local
# OpenVPN tunnel.
#
#   opencode -> utun (local OpenVPN) -> NordVPN -> LLM APIs
#
# Traffic routes through the tunnel transparently (full-tunnel with
# redirect-gateway) — no proxy and no other machine involved.
#
# Prereqs: local tunnel running (`sudo vpn-macos --vpnN`), local `opencode`
# binary, curl.
#
# Wrapper flags (everything else passes through to opencode):
#   --vpnN             switch to local profile vpnN before launching (runs sudo vpn-macos)
#   --stop             stop the local tunnel, then exit
#   --ip               print local tunnel exit IP, then exit
#   -h, --help         this help
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode-vpn"
PID_FILE="$CONFIG_DIR/openvpn.pid"
STATE_FILE="$CONFIG_DIR/current"
# Find vpn-macos: same dir as this script, then ~/.local/bin, then PATH.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VPN_MACOS=""
for candidate in "$SCRIPT_DIR/vpn-macos" "$HOME/.local/bin/vpn-macos"; do
    if [ -x "$candidate" ]; then VPN_MACOS="$candidate"; break; fi
done
[ -n "$VPN_MACOS" ] || VPN_MACOS="$(command -v vpn-macos 2>/dev/null || true)"

usage() {
    cat <<'EOF'
usage: opencode-vpn-macos [--vpnN] [--stop] [--ip] [-h] [opencode args...]

  --vpnN    switch to local profile vpnN, then launch opencode
  --stop    stop the local tunnel and exit
  --ip      print local tunnel exit IP and exit
  -h, --help  this help

Without --vpnN the existing tunnel is used as-is (start one first:
sudo vpn-macos --vpn2). Everything else is passed to opencode.
EOF
}

tunnel_running() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

current_profile() {
    [ -f "$STATE_FILE" ] && cat "$STATE_FILE" || echo "none"
}

exit_ip() { curl -s --max-time 8 https://ifconfig.me 2>/dev/null || true; }

# --- parse args ---------------------------------------------------------------
SHOW_IP=0
DO_STOP=0
SWITCH_PROFILE=""
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --vpn[0-9]*) SWITCH_PROFILE="${1#--}"; shift ;;
        --stop)      DO_STOP=1; shift ;;
        --ip)        SHOW_IP=1; shift ;;
        -h|--help)   usage; exit 0 ;;
        --)          shift; while [ $# -gt 0 ]; do ARGS+=("$1"); shift; done; break ;;
        *)           ARGS+=("$1"); shift ;;
    esac
done

[ -n "$VPN_MACOS" ] || { echo "ERROR: vpn-macos not found; run setup-macos.sh first" >&2; exit 1; }

# --- --stop --------------------------------------------------------------------
if [ "$DO_STOP" = 1 ]; then
    exec sudo "$VPN_MACOS" --stop
fi

# --- --vpnN switch --------------------------------------------------------------
if [ -n "$SWITCH_PROFILE" ]; then
    sudo "$VPN_MACOS" "--$SWITCH_PROFILE" || exit 1
fi

# --- verify tunnel is up (fail-closed) -------------------------------------------
if ! tunnel_running; then
    echo "ERROR: no local VPN tunnel running." >&2
    echo "start one first:  sudo vpn-macos --vpn2   (or use --vpnN here)" >&2
    exit 1
fi

VPN_IP="$(exit_ip)"
if [ -z "$VPN_IP" ]; then
    echo "ERROR: tunnel is up but cannot reach the internet (exit IP unknown)." >&2
    exit 1
fi
echo "vpn exit IP: $VPN_IP  (profile: $(current_profile))" >&2

if [ "$SHOW_IP" = 1 ]; then
    echo "local tunnel exit: $VPN_IP"
    echo "profile: $(current_profile)"
    exit 0
fi

OPENCODE="$(command -v opencode || true)"
[ -n "$OPENCODE" ] || OPENCODE="$HOME/.opencode/bin/opencode"
[ -x "$OPENCODE" ] || { echo "ERROR: opencode binary not found (install it first)" >&2; exit 1; }

# Traffic routes through the tunnel transparently (full-tunnel redirect-gateway).
# No proxy env vars needed — but harmless to set NO_PROXY for local addresses.
export NO_PROXY="localhost,127.0.0.1,::1" no_proxy="localhost,127.0.0.1,::1"

# "$@" on empty args trips `set -u` on bash 3.2, hence the branch.
if [ "${#ARGS[@]}" -eq 0 ]; then
    exec "$OPENCODE"
else
    exec "$OPENCODE" "${ARGS[@]}"
fi
